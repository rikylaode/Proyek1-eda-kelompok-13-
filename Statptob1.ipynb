   "source": [
    "# Membuat dataframe baru yang index barisnya adalah di bawah ini\n",
    "hasil = pd.DataFrame(index=[\n",
    "    \"Mean\",\n",
    "    \"Median\",\n",
    "    \"Mode\",\n",
    "    \"Minimum\",\n",
    "    \"Maximum\",\n",
    "    \"Range\",\n",
    "    \"Variance\",\n",
    "    \"Standar Deviasi\",\n",
